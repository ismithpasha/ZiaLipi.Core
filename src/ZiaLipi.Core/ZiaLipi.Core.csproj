<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZiaLipi.Core</RootNamespace>
    <!-- Files with an MPL notice in their header (and Data/) are MPL-2.0 -->
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\*.json;Data\*.gz" LogicalName="ZiaLipi.Data.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZiaLipi.Core.Tests" />
  </ItemGroup>

</Project>
